# Zugangsdaten des DNS-Anbieters, nur Traefik bekommt sie. Als dns.env speichern (steht nicht in Git).
# Der Zugang kann DNS-Einträge der Domain ändern, also so eng wie möglich beschränken.
# Anbieter und Variablen: https://doc.traefik.io/traefik/https/acme/#providers

# IONOS (DNS_PROVIDER=ionos), Schlüssel im Format Präfix.Geheimnis
IONOS_API_KEY=

# Cloudflare (DNS_PROVIDER=cloudflare)
# CF_DNS_API_TOKEN=
