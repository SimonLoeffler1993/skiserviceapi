# Alle Passwörter ändern und nur Buchstaben und Ziffern verwenden, z.B. openssl rand -hex 24.
# CHECKIN_APP_PASSWORD steht in einer URL, die übrigen in SQL und Umgebungsvariablen.

# Haupt-DB (Kundendaten, privater Schlüssel)
DB_ROOT_PASSWORD=aendern
DB_USER=skiservice
DB_PASSWORD=aendern
DB_NAME=skiservice

# Zwischendatenbank der Check-in-App, getrennte Passwörter. Die API legt damit bei jedem Start die Benutzer an,
# geänderte API-/App-Passwörter gelten nach einem Neustart. Das Root-Passwort gilt nur beim allerersten Start der DB.
CHECKIN_DB_ROOT_PASSWORD=aendern
CHECKIN_API_PASSWORD=aendern
CHECKIN_APP_PASSWORD=aendern

# Adressen im Laden. Im DNS des Ladens auf die IP dieses Hosts zeigen lassen
API_DOMAIN=api.ski.example.de
CENTER_DOMAIN=center.ski.example.de
KUNDEN_DOMAIN=terminal.ski.example.de
KASSE_DOMAIN=kasse.ski.example.de

# Zertifikate: Mail für Let's Encrypt, Anbieter-Kürzel siehe dns.env.beispiel
ACME_EMAIL=info@example.de
DNS_PROVIDER=ionos

# Traefik im Laden, darf nicht aus dem Internet erreichbar sein
INTERN_HTTP_PORT=80
INTERN_HTTPS_PORT=443
# Unverschlüsselt für den Hardware-Scanner, dort als Server-Adresse http://<Host-IP>:8000 eintragen
SCANNER_PORT=8000
PMA_PORT=8081

# Check-in-App: Domain für das HTTPS-Zertifikat, zeigt auf den Internet-Anschluss.
# Im Router extern 80 -> CHECKIN_HTTP_PORT und extern 443 -> CHECKIN_HTTPS_PORT weiterleiten
CHECKIN_DOMAIN=checkin.example.de
CHECKIN_HTTP_PORT=8080
CHECKIN_HTTPS_PORT=8443
CHECKIN_PRUEFDIALOG=true
CHECKIN_DATENSCHUTZ_URL=
CHECKIN_IMPRESSUM_URL=

# Alle anderen Einstellungen (E-Mail, Drucker, Lexware, Firma, ...) stehen im Center unter Verwalten -> Einstellungen.
# Die "Öffentliche Adresse" dort ist die Basis der QR-Codes auf den Etiketten, also https://<CENTER_DOMAIN> eintragen.
