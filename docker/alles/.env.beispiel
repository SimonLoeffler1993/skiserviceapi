# Datenbank
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=SicheresPasswort123
DB_NAME=skiservice

# phpMyAdmin
PMA_PORT=8081

# Alle Einstellungen außer der Datenbank werden im Skiservice Center unter
# Verwalten -> Einstellungen gepflegt. Die folgenden Variablen werden nur beim
# ersten Start einmalig übernommen und können danach entfernt werden.

# Lexware
LEXWARE_APIKEY=your_api_key_here

# Labeldrucker
LABELPRINTERIDENT=tcp://192.168.1.100

# --- Benutzerverwaltung ---
# Optional, nur für den allerersten Start: legt diesen Admin an. Sonst im Center unter /einrichtung.
ADMIN_BENUTZER=
ADMIN_PASSWORT=
# Geräteschlüssel des Kundenterminals (im Center unter Verwalten → Geräte erzeugen)
TERMINAL_SCHLUESSEL=
# Alles Weitere im Center unter Verwalten → Einstellungen → "Benutzer & Anmeldung" bzw. "Anmeldung mit OIDC":
# - Adressen von Center, Kasse und Kundenterminal (CORS und OIDC-Rücksprung)
# - Erst wenn alle Geräte angemeldet sind und Scanner/Terminal einen Schlüssel haben:
#   "Geräteschlüssel erzwingen" und "Anmeldung erzwingen" einschalten
# Notzugang: docker exec -it skiserviceapi python -m app.benutzer_notfall --anmeldung-aus
