# Alle Passwörter ändern und nur Buchstaben und Ziffern verwenden, z.B. openssl rand -hex 24.
# CHECKIN_APP_PASSWORD steht in einer URL, die übrigen in SQL und Umgebungsvariablen.

# Haupt-DB (Kundendaten, privater Schlüssel)
DB_ROOT_PASSWORD=aendern
DB_USER=skiservice
DB_PASSWORD=aendern
DB_NAME=skiservice

# Zwischendatenbank der Check-in-App, getrennte Passwörter
CHECKIN_DB_ROOT_PASSWORD=aendern
CHECKIN_API_PASSWORD=aendern
CHECKIN_APP_PASSWORD=aendern

# Adresse der API, wie Center und Kundenterminal sie erreichen
BACKEND_URL=http://skiserviceapi:8000

# Ports im Laden
API_PORT=8000
KUNDENTERMINAL_PORT=3000
CENTER_PORT=3001
PMA_PORT=8081

# Check-in-App: Domain für das HTTPS-Zertifikat, muss auf diesen Host zeigen
CHECKIN_DOMAIN=checkin.example.com
CHECKIN_HTTP_PORT=80
CHECKIN_HTTPS_PORT=443
CHECKIN_PRUEFDIALOG=true
CHECKIN_DATENSCHUTZ_URL=
CHECKIN_IMPRESSUM_URL=

# Werden nur beim ersten Start übernommen, danach im Center unter Verwalten -> Einstellungen
HOST=
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
LEXWARE_APIKEY=
LABELPRINTERIDENT=
